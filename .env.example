# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Free stock footage key from https://www.pexels.com/api/ (optional)
PEXELS_API_KEY=
# Tech channel: optional, free, read-only token for public repos (raises GitHub limits from 60 to 5,000 requests an hour)
GITHUB_TOKEN=
# Off-server backup: a git@github.com:owner/repo.git address and the path of the deploy key (names only here; values live in the server .env)
BACKUP_REPO_URL=
BACKUP_SSH_KEY_FILE=
