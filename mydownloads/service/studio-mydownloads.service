[Unit]
Description=My Downloads: saves the owner's own YouTube videos to the Desktop (listens on 127.0.0.1 only)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python -m mydownloads
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
