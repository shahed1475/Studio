# Copy to .env and fill in. Never commit the real .env.
# Your Kaggle token is NOT set here -- it goes in ~/.kaggle/kaggle.json (chmod 600),
# downloaded from kaggle.com -> Settings -> API -> Create New Token.

KAGGLE_USERNAME=your-kaggle-username   # the Kaggle account name (not the GitHub one)

# Quota limits. Check your real GPU figure in Kaggle account settings --
# Kaggle says "30 hours or sometimes higher", so this is a floor.
KAGGLE_GPU_WEEKLY_HOURS=30
KAGGLE_TPU_WEEKLY_HOURS=20
# Modal is a PAID service with free credit; off unless MODAL_ENABLED=1 (cost below is only an estimate)
MODAL_ENABLED=
MODAL_MONTHLY_CREDIT_USD=30
MODAL_USD_PER_GPU_HOUR=0.60
ROUTER_SAFETY_MARGIN_HOURS=1
ROUTER_SHORT_JOB_MINUTES=20

# Kaggle allows personal, non-commercial use only. Set this ONLY to the reference of Kaggle's written permission for commercial work.
KAGGLE_COMMERCIAL_PERMISSION_REF=

# Cloudflare R2 (optional; disables the storage helpers if unset)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
