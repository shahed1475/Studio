+def quota_preflight(job: dict, env_cfg: dict, run=subprocess.run) -> tuple[bool, str]:
+    """(allowed, why) before any push: the LIVE quota from `kaggle quota` (CLI 2.2.5, get_accelerator_quota_statistics), never the fixed
+    weekly_gpu_hours; no push while another studio Kaggle job is waiting or running (Kaggle docs: a second commit makes a concurrent batch
+    session); never a session longer than session_hours. Unknown means no."""
+    q = _cli(["quota", "--format", "json"], run=run, timeout=60)
+    try:
+        rows = json.loads(q.stdout)
+        rows = rows if isinstance(rows, list) else [rows]
+        gpu = next(r for r in rows if str(r.get("resource", "")).upper() == "GPU")
+        remaining = float(str(gpu["remaining"]).rstrip("h"))
+    except (ValueError, TypeError, KeyError, AttributeError, StopIteration):
+        return False, "quota unknown: `kaggle quota` gave no readable GPU line"
+    busy = [j["id"] for j in computejobs.all_jobs(200) if j.get("kaggle_ref") and j["id"] != job["id"]
+            and j["status"] in ("PREPARING", "MODEL_LOADING", "RUNNING", "CHECKPOINTED", "RECOVERY_PENDING")]
+    if busy:
+        return False, f"another Kaggle job is not finished yet ({', '.join(busy[:3])}): one GPU session at a time"
+    cap_h = int(job.get("timeout_s") or 3600) / 3600
+    limit_h = float(env_cfg.get("session_hours") or 9)
+    if cap_h > limit_h:
+        return False, f"time cap {cap_h:.1f} h is longer than a Kaggle GPU session ({limit_h:g} h)"
+    margin = float(env_cfg.get("quota_safety_margin_h", 2.0))
+    if remaining < cap_h + margin:
+        return False, f"{remaining:.2f} GPU h left this week; this job may use {cap_h:.2f} h and {margin:g} h is kept in reserve"
+    return True, f"{remaining:.2f} GPU h left; cap {cap_h:.2f} h"
+
